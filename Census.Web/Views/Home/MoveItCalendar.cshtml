@using System.Text.Json
@using Census.Web.Options
@using Microsoft.Extensions.Options
@inject IOptions<MoveItOptions> MoveItOptions
@{
    ViewData["Title"] = "Calendar";
    var config = JsonSerializer.Serialize(new { rootId = "moveit-root", releaseHues = MoveItOptions.Value.ReleaseHues });
}

@section Styles {
    <link rel="stylesheet" href="~/css/moveit.css" asp-append-version="true" />
}

<div id="moveit-root"></div>

@section Scripts {
    <script type="module">
        import calendarPage from '/js/moveit/calendar-page.mjs';
        calendarPage.init(@Html.Raw(config));
    </script>
}
