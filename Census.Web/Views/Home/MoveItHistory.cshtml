@using System.Text.Json
@using Census.Web.Options
@using Microsoft.Extensions.Options
@inject IOptions<MoveItOptions> MoveItOptions
@{
    ViewData["Title"] = "History";
    var config = JsonSerializer.Serialize(new
    {
        rootId = "moveit-root",
        staleDays = MoveItOptions.Value.StaleDays,
        comingDays = MoveItOptions.Value.ComingDays,
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/moveit.css" asp-append-version="true" />
}

<div id="moveit-root"></div>

@section Scripts {
    <script type="module">
        import historyPage from '/js/moveit/history-page.mjs';
        historyPage.init(@Html.Raw(config));
    </script>
}
