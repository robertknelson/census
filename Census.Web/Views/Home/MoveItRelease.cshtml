@{
    ViewData["Title"] = "Release";
}

@section Styles {
    <link rel="stylesheet" href="~/css/moveit.css" asp-append-version="true" />
}

<div id="moveit-root"></div>

@section Scripts {
    <script type="module">
        import releasePage from '/js/moveit/release-page.mjs';
        releasePage.init({ rootId: 'moveit-root', releaseId: @ViewData["ReleaseId"] });
    </script>
}
