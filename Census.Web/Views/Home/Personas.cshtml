@using System.Text.Json
@using Census.Web.Options
@using Microsoft.Extensions.Options
@inject IOptions<PersonasOptions> PersonasOptions
@inject IOptions<MoveItOptions> MoveItOptions
@inject IOptions<UsageOptions> UsageOptions
@{
    // Its own page, not _Layout: the persona UX is built beside the existing UIs and borrows
    // nothing from them, including the v1/v2 switch (personas.md §2).
    Layout = null;
    var config = JsonSerializer.Serialize(new { rootId = "personas-root", fiscalStart = PersonasOptions.Value.FiscalYearStartMonth,
        estateApplication = PersonasOptions.Value.EstateApplication,
        staleDays = MoveItOptions.Value.StaleDays, comingDays = MoveItOptions.Value.ComingDays,
        shippedDays = MoveItOptions.Value.ShippedDays, stepCaptions = MoveItOptions.Value.StepCaptions,
        usageFriction = new { endedWithinMinutes = UsageOptions.Value.Friction.EndedWithinMinutes, refusedTimes = UsageOptions.Value.Friction.RefusedTimes,
            loopLoads = UsageOptions.Value.Friction.LoopLoads, loopSeconds = UsageOptions.Value.Friction.LoopSeconds, retrySeconds = UsageOptions.Value.Friction.RetrySeconds } });
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Census personas</title>
    <link rel="stylesheet" href="~/css/moveit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/feature-access.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personas.css" asp-append-version="true" />
</head>
<body>
    <div id="personas-root"></div>
    <script type="module">
        import personasPage from '/js/personas/personas-page.mjs';
        personasPage.init(@Html.Raw(config));
    </script>
</body>
</html>
