{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MoveIt": {
    "ConnectionString": "Server=localhost;Database=AppTrak;Integrated Security=true;TrustServerCertificate=true",
    "By": "demo-board"
  },
  "Census": {
    "AssertionsInDatabase": [ "entity-tags", "systems", "stage-crossings", "declared-entities", "assets", "baselines", "blacklist", "views" ]
