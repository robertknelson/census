@{
    ViewData["Title"] = "Home";
    var roles = (List<string>)ViewData["Roles"];
    var features = (List<(string Name, bool On)>)ViewData["Features"];
}
<h1 class="gh-h1">Who you are here</h1>
<p class="gh-sub">Signed in by Windows as <code>@User.Identity?.Name</code>; your identifier in membership is
    <code>@User.FindFirst(ClaimsTransformer.IdentifierClaim)?.Value</code>.</p>

<section class="gh-card">
    <h2 class="gh-h2">Your roles on this application</h2>
    @if (roles.Count == 0)
    {
        <p class="gh-muted">None. You are signed in, but no role is granted to you on this application, so every gated page refuses you.</p>
    }
    else
    {
        <ul class="gh-chips">@foreach (var role in roles) { <li>@role</li> }</ul>
    }
</section>

<section class="gh-card">
    <h2 class="gh-h2">Features, for you</h2>
    <p class="gh-muted">On when the feature's switch is on and one of your roles is granted it (FM2280). The sidebar shows what is on; the pages behind it refuse the rest.</p>
    <table class="gh-table">
        <thead><tr><th>Feature</th><th>For you</th></tr></thead>
        <tbody>
            @foreach (var feature in features)
            {
                <tr><td><code>@feature.Name</code></td><td class="@(feature.On ? "gh-on" : "gh-off")">@(feature.On ? "on" : "off")</td></tr>
            }
        </tbody>
    </table>
</section>
