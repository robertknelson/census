{
  "version": 1,
  "buckets": [
    {
      "id": "corp",
      "description": "Domain-joined production - the scheduled task's own identity",
      "credential": { "kind": "task-identity" }
    },
    {
      "id": "dmz",
      "description": "DMZ web tier, separate forest - NTLM, so TrustedHosts is required",
      "credential": { "kind": "clixml", "path": "config\\creds\\dmz.cred.xml" },
      "trustedHosts": ["OLDVM01"]
    }
  ],
  "machines": [
    { "name": "WEB01",         "bucket": "corp", "expected": true,  "notes": "" },
    { "name": "WEB02",         "bucket": "corp", "expected": true,  "notes": "physical; second web tier" },
    { "name": "SQL01",         "bucket": "corp", "expected": true,  "notes": "" },
    { "name": "SQL02",         "bucket": "corp", "expected": true,  "notes": "2016; default instance" },
    { "name": "APPSRV01",      "bucket": "corp", "expected": true,  "notes": "" },
    { "name": "DEVBOX-JSMITH", "bucket": "corp", "expected": true,  "notes": "laptop; often off" },
    { "name": "BUILDSRV01",    "bucket": "corp", "expected": true,  "notes": "" },
    { "name": "LEGACY-DC01",   "bucket": "corp", "expected": true,  "notes": "" },
    { "name": "FILESRV01",     "bucket": "corp", "expected": true,  "notes": "tree restored from backup; run-log history lost" },
    { "name": "OLDVM01",       "bucket": "dmz",  "expected": true,  "notes": "workgroup; NTLM fallback" },
    { "name": "DCBACKUP01",    "bucket": "corp", "expected": false, "notes": "decommissioned, kept to prove absence is signal" },
    { "name": "DEVWEBBOX",     "bucket": "corp", "expected": true,  "notes": "stage topology: DEV web tier" },
    { "name": "VALWEBBOX",     "bucket": "corp", "expected": true,  "notes": "stage topology: VAL web tier" },
    { "name": "PRODWEBBOX",    "bucket": "corp", "expected": true,  "notes": "stage topology: PROD web tier" },
    { "name": "DEVSQLBOX",     "bucket": "corp", "expected": true,  "notes": "stage topology: serves DEV and VAL both - the shared box" },
    { "name": "PRODSQLBOX",    "bucket": "corp", "expected": true,  "notes": "stage topology: PROD database tier" },
    { "name": "LOGBOX",        "bucket": "corp", "expected": true,  "notes": "stage topology: the Telemetry service, one site per stage - the cross-cutting fixture" }
  ]
}
